{
  "name": "cliyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin orchestrator: Windows entry → WSL CLI workers (capability-based, no Docker required)",
  "bin": {
    "cliyard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "run-task": "tsx src/cli.ts run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
