{
  "name": "cliyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design-to-Evidence Delivery Control Plane: Plan → frozen contracts → isolated workers → independent evidence",
  "bin": {
    "cliyard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "run-task": "tsx src/cli.ts run",
    "batch": "tsx src/cli.ts batch",
    "mock-loop": "tsx src/cli.ts mock-loop",
    "mock-batch": "tsx src/cli.ts mock-batch",
    "codex-batch": "tsx src/cli.ts codex-batch",
    "claude-batch": "tsx src/cli.ts claude-batch",
    "plan-dispatch": "tsx src/cli.ts plan-dispatch",
    "architect": "tsx src/cli.ts architect",
    "queue": "tsx src/cli.ts queue",
    "estimate-plan": "tsx src/cli.ts estimate-plan",
    "runtime-drill": "tsx src/cli.ts runtime-drill",
    "eval": "tsx src/cli.ts eval",
    "harness-eval": "tsx src/cli.ts eval --snapshot --record-only",
    "test:harness-eval": "tsx --test tests/harness-eval-core.test.ts tests/harness-eval-cli.test.ts tests/harness-eval-handoff.test.ts",
    "master-dispatch": "node plugins/dsh-cliyard/lib/dispatch-cli.js",
    "master-monitor": "node plugins/dsh-cliyard/lib/monitor-cli.js",
    "mvp-test": "tsx src/cli.ts mvp-test",
    "mvp-compile": "tsx src/cli.ts mvp-compile",
    "mvp-freeze": "tsx src/cli.ts mvp-freeze",
    "mvp-demo": "tsx src/cli.ts mvp-demo",
    "glass-dry": "tsx src/cli.ts codex-batch examples/glass-parallel.contracts.json --repo ../ui-prototype --dry-run",
    "glass-dispatch": "tsx src/cli.ts codex-batch examples/glass-parallel.contracts.json --repo ../ui-prototype --model deepseek-flash --keep-worktrees",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
