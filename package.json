{
  "name": "cliyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin orchestrator: Windows entry → WSL CLI workers (capability-based, no Docker required)",
  "bin": {
    "cliyard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "run-task": "tsx src/cli.ts run",
    "batch": "tsx src/cli.ts batch",
    "mock-loop": "tsx src/cli.ts mock-loop",
    "mock-batch": "tsx src/cli.ts mock-batch",
    "codex-batch": "tsx src/cli.ts codex-batch",
    "claude-batch": "tsx src/cli.ts claude-batch",
    "plan-dispatch": "tsx src/cli.ts plan-dispatch",
    "architect": "tsx src/cli.ts architect",
    "estimate-plan": "tsx src/cli.ts estimate-plan",
    "runtime-drill": "tsx src/cli.ts runtime-drill",
    "master-dispatch": "node plugins/dsh-cliyard/lib/dispatch-cli.js",
    "master-monitor": "node plugins/dsh-cliyard/lib/monitor-cli.js",
    "glass-dry": "tsx src/cli.ts codex-batch examples/glass-parallel.contracts.json --repo ../ui-prototype --dry-run",
    "glass-dispatch": "tsx src/cli.ts codex-batch examples/glass-parallel.contracts.json --repo ../ui-prototype --model deepseek-flash --keep-worktrees",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
