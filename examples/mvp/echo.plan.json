{
  "planId": "mvp-echo-plan",
  "scene": "code",
  "tasks": [
    {
      "taskId": "mvp-echo-from-plan",
      "goal": "M3: compile+freeze then idle-spin echo fixture from Plan draft",
      "nonGoals": [
        "Do not call a coding model",
        "Do not auto-dispatch on compile"
      ],
      "acceptance": [
        "Child process cwd equals workspace.path",
        "verify commands exit 0"
      ],
      "workspace": {
        "kind": "git-worktree",
        "path": ".cliyard/worktrees/mvp-echo-from-plan",
        "baseRef": "HEAD",
        "writeRoots": [".cliyard/mvp-echo/"]
      },
      "driver": {
        "kind": "local-cli",
        "target": "custom:echo-ok",
        "argv": [
          "sh",
          "-c",
          "mkdir -p .cliyard/mvp-echo && echo ok > .cliyard/mvp-echo/hello.txt"
        ],
        "stdin": { "mode": "none" },
        "env": { "CLIYARD_RUN_MODE": "contract" },
        "timeoutSec": 60
      },
      "sandbox": { "mode": "none" },
      "verify": {
        "commands": [
          {
            "argv": ["test", "-f", ".cliyard/mvp-echo/hello.txt"],
            "cwd": "workspace"
          }
        ]
      },
      "cleanup": {
        "onCancel": "dispose-child",
        "keepWorkspace": true
      }
    }
  ]
}
