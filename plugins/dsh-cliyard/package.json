{
  "name": "dsh-cliyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Master plugin: dispatch cliyard batches + monitor ledger",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "public/",
    "README.md"
  ],
  "bin": {
    "dsh-cliyard-dispatch": "./lib/dispatch-cli.js",
    "dsh-cliyard-monitor": "./lib/monitor-cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
